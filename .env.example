# ─── Casper network ──────────────────────────────────────────────────────────
CASPER_CHAIN_NAME=casper-test
CASPER_NODE_RPC=https://node.testnet.cspr.cloud/rpc

# CSPR.cloud access token (https://console.cspr.build) — sent as the raw
# Authorization header on the node proxy, REST API, and x402 facilitator.
CSPR_CLOUD_API_KEY=
CSPR_CLOUD_REST_URL=https://api.testnet.cspr.cloud

# ─── Deployer / operator key ─────────────────────────────────────────────────
# Either a Casper Wallet BIP-39 mnemonic (secp256k1, path m/44'/506'/0'/0/0)...
CASPER_MNEMONIC=
# ...or a PEM secret key path. PEM wins when both are set.
CASPER_SECRET_KEY_PATH=
# BIP-44 account index the mnemonic signs with (Casper Wallet may place the
# funded account at index > 0).
CASPER_MNEMONIC_INDEX=0
# Optional sanity check: derived public key must match this hex.
CASPER_PUBLIC_KEY_HEX=

# ─── x402 ────────────────────────────────────────────────────────────────────
X402_FACILITATOR_URL=https://x402-facilitator.cspr.cloud
# Port + price of the oracle agent's paywalled report endpoint.
X402_PORT=4021
X402_PRICE_ATOMIC=500000000

# ─── LLM (OpenAI-compatible) ─────────────────────────────────────────────────
OPENAI_API_KEY=
NEBULA_LLM_BASE_URL=https://api.openai.com/v1
NEBULA_LLM_MODEL=gpt-4o-mini

# ─── Deployed contract package hashes (filled by scripts/deploy.ts) ──────────
NEBULA_NUSD_PACKAGE_HASH=
NEBULA_IDENTITY_PACKAGE_HASH=
NEBULA_ORACLE_HUB_PACKAGE_HASH=
NEBULA_COMPLIANCE_PACKAGE_HASH=
NEBULA_VAULT_PACKAGE_HASH=
